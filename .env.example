# --- Supabase (projekt w regionie EU-Frankfurt) ---
# Bez tych dwóch zmiennych panel działa w trybie DEMO (dane w pamięci, bez logowania)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Klucz serwisowy — tylko do zadań administracyjnych po stronie serwera (nigdy w przeglądarce)
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n (dashboard CEO) ---
# np. https://n8n.stronevo.pl — klucz z Settings > n8n API
N8N_BASE_URL=
N8N_API_KEY=

# --- VPS (dashboard CEO) ---
# Nazwa hosta do wyświetlania + endpoint JSON z metrykami (RAM/dysk/load)
VPS_HOST=
VPS_METRICS_URL=
VPS_METRICS_TOKEN=

# --- Healthchecks.io (dashboard CEO) ---
# Klucz Management API (read-only wystarczy) do odczytu statusów checków
HC_API_KEY=
# Ping URL — używany przez workflowy/crony do zgłaszania "żyję"
HC_PING=

# --- Fakturownia (Faza 2 — faktury) ---
# Subdomena konta (https://<DOMAIN>.fakturownia.pl) + token API
FAKTUROWNIA_DOMAIN=
FAKTUROWNIA_API_KEY=

# --- E-mail (Faza 2 — umowy, loginy, przypomnienia) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=kontakt@stronevo.pl

# --- Telegram (Faza 2 — push powiadomień) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Powiadomienia (Faza 2) ---
# Token dla POST /api/notifications (zewnętrzne źródła: monitor VPS, n8n)
NOTIFY_API_TOKEN=
# Po ilu dniach nieopłacona faktura staje się zaległa (default 7)
INVOICE_OVERDUE_DAYS=7

# --- Umowy (Faza 2) ---
# Numer konta do sekcji płatności w umowie ({{nr_konta}})
BANK_ACCOUNT=
# Moduł głosowy w umowie (Załącznik nr 3) — puste = domyślne 500 / 1,39 / 1500
VOICE_LIMIT_MINUT=
VOICE_STAWKA_OVERAGE=
VOICE_CAP_MINUT=

# --- Meta Custom Audiences (Faza 3 — remarketing) ---
# Token systemowy z uprawnieniem ads_management + ID konta reklamowego (bez "act_")
META_TOKEN=
META_AD_ACCOUNT_ID=

# --- Control plane agentów (Faza 4) ---
# Token dla POST /api/agent/run i POST /api/server/provision (Hermes/playbook na VPS)
AGENT_API_TOKEN=

# --- Pluggable LLM (Faza 4) — WSZYSTKIE wywołania AI przez lib/llm/provider.ts ---
# anthropic | openai | selfhost (selfhost = własny model z Hugging Face,
# endpoint OpenAI-compatible, np. vLLM/TGI na GPU-serwerze)
LLM_PROVIDER=
LLM_BASE_URL=
LLM_KEY=
LLM_MODEL=

# --- Aplikacja desktop (Faza 5 — wrapper Tauri) ---
# Link pobierania instalatora ze strony logowania (bez ENV: komunikat 404)
DESKTOP_DOWNLOAD_URL=
# Manifest auto-update (GET /api/desktop/latest); bez ENV: 204 = brak aktualizacji
DESKTOP_VERSION=
DESKTOP_UPDATE_URL=
DESKTOP_SIGNATURE=
DESKTOP_NOTES=
DESKTOP_PUB_DATE=

# --- Godziny pracy / połączenia (dodatek F3 — Ekran Kasy) ---
# Google Places API — auto-zaczyt godzin z wizytówki Google (bez klucza: mock)
GOOGLE_PLACES_API_KEY=
# Vapi — realne połączenia Ady do live dashboardu (bez klucza: mock)
VAPI_API_KEY=

# --- Panel Wartości (Ekran Kasy + follow-up SMS) ---
# Współczynnik konserwatywny wyceny (0.6-0.7; default 0.65) — kwoty celowo zaniżane
VALUE_CONSERVATIVE_FACTOR=0.65
# SMS — priorytet Zadarma (user ma konto). PŁATNE ~0,16-0,24 zł/SMS. Klucze w panelu Zadarma → API.
ZADARMA_KEY=
ZADARMA_SECRET=
ZADARMA_SENDER=
# Alternatywa DARMOWA (0 zł/SMS): brama na własnym telefonie (TextBee/SMSGate) lub webhook n8n.
# Używane tylko gdy brak kluczy Zadarma. Bez żadnego: mock.
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=
