{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STRONEVO OS",
  "version": "1.0.0",
  "identifier": "pl.stronevo.os",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "STRONEVO OS",
        "url": "https://crm.stronevo.pl",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Polish"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://crm.stronevo.pl/api/desktop/latest"],
      "pubkey": "WSTAW_PUBKEY_Z_tauri_signer_generate"
    }
  }
}
